+//! `unit_catalog() -> (unit, dimension, base_unit, quantity_space, factor, offset,
+//! implementation_version, contract_version)` — the versioned, authoritative
+//! unit definitions behind the strict conversion functions, for administrative
+//! approval: `base = value * factor + offset`, or `base_difference = value *
+//! factor` for differences. One row per exact recognized unit string.
+
+use arrow_array::{ArrayRef, Float64Array, RecordBatch, StringArray};
+use arrow_schema::{DataType, Field, Schema, SchemaRef};
+use std::sync::Arc;
+use vgi::table_function::{TableFunction, TableProducer};
+use vgi::{ArgSpec, BindParams, BindResponse, FunctionMetadata, ProcessParams};
+use vgi_rpc::{OutputCollector, Result, RpcError};
+
+/// The strict-conversion contract version reported in every row.
+pub const CONTRACT_VERSION: &str = "1";
+
+/// Guaranteed-runnable, catalog-qualified examples (VGI509).
+const EXECUTABLE_EXAMPLES: &str = r#"[
+  {
+    "description": "Show the factor and offset that define each temperature unit.",
+    "sql": "SELECT unit, factor, \"offset\" FROM units.main.unit_catalog() WHERE dimension = 'temperature' ORDER BY unit"
+  },
+  {
+    "description": "Report the worker and contract versions the definitions belong to.",
+    "sql": "SELECT DISTINCT implementation_version, contract_version FROM units.main.unit_catalog()"
+  }
+]"#;
+
+pub struct UnitCatalog;
+
+fn commented(name: &str, ty: DataType, comment: &str) -> Field {
+    Field::new(name, ty, false).with_metadata(std::collections::HashMap::from([(
+        "comment".to_string(),
+        comment.to_string(),
+    )]))
+}
+
+/// The columns produced by `unit_catalog` — shared by the table function's
+/// `on_bind` and the catalog table `units.main.unit_catalog`.
+pub fn output_schema() -> SchemaRef {
+    Arc::new(Schema::new(vec![
+        commented(
+            "unit",
+            DataType::Utf8,
+            "The exact recognized unit string, e.g. 'km', 'MB', '°C'. Case-significant.",
+        ),
+        commented(
+            "dimension",
+            DataType::Utf8,
+            "The physical dimension the unit measures, e.g. 'length' or 'temperature'.",
+        ),
+        commented(
+            "base_unit",
+            DataType::Utf8,
+            "The SI base unit of the dimension that conversions pass through, e.g. 'm'.",
+        ),
+        commented(
+            "quantity_space",
+            DataType::Utf8,
+            "'affine' for temperature units (offsets apply to absolute values and cancel for \
+             differences); 'linear' for every other dimension.",
+        ),
+        commented(
+            "factor",
+            DataType::Float64,
+            "Scale factor to the base unit: base = value * factor + offset. Finite and positive.",
+        ),
+        commented(
+            "offset",
+            DataType::Float64,
+            "Additive offset to the base unit (non-zero only for affine temperature scales); \
+             ignored when converting differences.",
+        ),
+        commented(
+            "implementation_version",
+            DataType::Utf8,
+            "The worker software version that serves these definitions.",
+        ),
+        commented(
+            "contract_version",
+            DataType::Utf8,
+            "The strict-conversion contract version these definitions satisfy.",
+        ),
+    ]))
+}
+
+impl TableFunction for UnitCatalog {
+    fn name(&self) -> &str {
+        "unit_catalog"
+    }
+
+    fn metadata(&self) -> FunctionMetadata {
+        let mut tags = crate::meta::object_tags(
+            "Unit Definition Catalog",
+            "The authoritative, versioned unit definitions used by convert_strict and \
+             convert_difference_strict: one row per exact unit string with its dimension, SI \
+             base unit, scale factor and offset (base = value * factor + offset; differences use \
+             the factor only), plus the worker implementation and contract versions. Use it to \
+             audit or approve the exact conversion constants.",
+            "Versioned unit definitions for conversion approval. Columns: `unit`, `dimension`, \
+             `base_unit`, `quantity_space`, `factor`, `offset`, `implementation_version`, `contract_version`.",
+            "unit catalog, unit definitions, conversion factor, offset, version, audit, approval, \
+             governance, strict conversion",
+            "Discovery",
+            "table/unit_catalog.rs",
+        );
+        tags.push((
+            "vgi.result_columns_schema".into(),
+            r#"[
+  {"name": "unit", "type": "VARCHAR", "description": "The exact recognized unit string."},
+  {"name": "dimension", "type": "VARCHAR", "description": "The physical dimension the unit measures."},
+  {"name": "base_unit", "type": "VARCHAR", "description": "The SI base unit of the dimension."},
+  {"name": "quantity_space", "type": "VARCHAR", "description": "'affine' for temperature units, 'linear' otherwise."},
+  {"name": "factor", "type": "DOUBLE", "description": "Scale factor: base = value * factor + offset."},
+  {"name": "offset", "type": "DOUBLE", "description": "Additive offset to the base unit (temperature scales only)."},
+  {"name": "implementation_version", "type": "VARCHAR", "description": "The worker software version."},
+  {"name": "contract_version", "type": "VARCHAR", "description": "The strict-conversion contract version."}
+]"#
+            .into(),
+        ));
+        tags.push(("vgi.executable_examples".into(), EXECUTABLE_EXAMPLES.into()));
+        FunctionMetadata {
+            description: "Versioned unit definitions for administrative validation: \
+                          base=value*factor+offset; differences use factor only"
+                .into(),
+            tags,
+            ..Default::default()
+        }
+    }
+
+    fn argument_specs(&self) -> Vec<ArgSpec> {
+        Vec::new()
+    }
+
+    fn on_bind(&self, _: &BindParams) -> Result<BindResponse> {
+        Ok(BindResponse {
+            output_schema: output_schema(),
+            opaque_data: Vec::new(),
+        })
+    }
+
+    fn producer(&self, params: &ProcessParams) -> Result<Box<dyn TableProducer>> {
+        Ok(Box::new(Producer {
+            schema: params.output_schema.clone(),
+            done: false,
+        }))
+    }
+}
+
+struct Producer {
+    schema: SchemaRef,
+    done: bool,
+}
+
+impl TableProducer for Producer {
+    fn next_batch(&mut self, _: &mut OutputCollector) -> Result<Option<RecordBatch>> {
+        if self.done {
+            return Ok(None);
+        }
+        self.done = true;
+        Ok(Some(catalog_batch(self.schema.clone())?))
+    }
+    // Single batch: the bounded static catalog is emitted in one RecordBatch,
+    // so there is no cursor to resume across HTTP turns.
+    fn resume_supported(&self) -> bool {
+        false
+    }
+}
+
+fn catalog_batch(schema: SchemaRef) -> Result<RecordBatch> {
+    let units = crate::units::supported_units();
+    let definitions: Vec<_> = units
+        .iter()
+        .map(|row| crate::units::lookup(row.unit).expect("catalog unit must resolve"))
+        .collect();
+    let columns: Vec<ArrayRef> = vec![
+        Arc::new(StringArray::from(
+            units.iter().map(|r| r.unit).collect::<Vec<_>>(),
+        )),
+        Arc::new(StringArray::from(
+            units.iter().map(|r| r.dimension).collect::<Vec<_>>(),
+        )),
+        Arc::new(StringArray::from(
+            units.iter().map(|r| r.base_unit).collect::<Vec<_>>(),
+        )),
+        Arc::new(StringArray::from(
+            definitions
+                .iter()
+                .map(|d| crate::unit_catalog_metadata::quantity_space(d.dimension))
+                .collect::<Vec<_>>(),
+        )),
+        Arc::new(Float64Array::from(
+            definitions.iter().map(|d| d.factor).collect::<Vec<_>>(),
+        )),
+        Arc::new(Float64Array::from(
+            definitions.iter().map(|d| d.offset).collect::<Vec<_>>(),
+        )),
+        Arc::new(StringArray::from(vec![crate::version(); units.len()])),
+        Arc::new(StringArray::from(vec![CONTRACT_VERSION; units.len()])),
+    ];
+    RecordBatch::try_new(schema, columns).map_err(|e| RpcError::runtime_error(e.to_string()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::Value;
+    use std::collections::HashMap;
+
+    #[test]
+    fn complete_table_catalog_matches_scalar_metadata_and_engine() {
+        let batch = catalog_batch(output_schema()).unwrap();
+        let catalog: Value = serde_json::from_str(crate::unit_catalog_json()).unwrap();
+        let json_rows: HashMap<_, _> = catalog["units"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|row| (row["unit"].as_str().unwrap(), row))
+            .collect();
+        assert_eq!(batch.num_rows(), json_rows.len());
+        assert_eq!(batch.num_columns(), 8);
+        let strings = |col: usize| {
+            batch
+                .column(col)
+                .as_any()
+                .downcast_ref::<StringArray>()
+                .unwrap()
+        };
+        let doubles = |col: usize| {
+            batch
+                .column(col)
+                .as_any()
+                .downcast_ref::<Float64Array>()
+                .unwrap()
+        };
+        for row in 0..batch.num_rows() {
+            let unit = strings(0).value(row);
+            let definition = crate::units::lookup(unit).unwrap();
+            let json = json_rows[unit];
+            assert_eq!(strings(1).value(row), definition.dimension.name());
+            assert_eq!(strings(2).value(row), definition.dimension.base_unit());
+            assert_eq!(doubles(4).value(row).to_bits(), definition.factor.to_bits());
+            assert_eq!(doubles(5).value(row).to_bits(), definition.offset.to_bits());
+            assert_eq!(strings(1).value(row), json["dimension"].as_str().unwrap());
+            assert_eq!(
+                strings(3).value(row),
+                json["quantity_space"].as_str().unwrap()
+            );
+            assert_eq!(strings(2).value(row), json["base_unit"].as_str().unwrap());
+            assert_eq!(
+                doubles(4).value(row).to_bits(),
+                json["factor"].as_f64().unwrap().to_bits()
+            );
+            assert_eq!(
+                doubles(5).value(row).to_bits(),
+                json["offset"].as_f64().unwrap().to_bits()
+            );
+            assert_eq!(strings(6).value(row), crate::version());
+            assert_eq!(strings(7).value(row), "1");
+        }
+    }
+}
diff --git a/crates/units-worker/src/unit_catalog_metadata.rs b/crates/units-worker/src/unit_catalog_metadata.rs
new file mode 100644
index 0000000..dc70821
--- /dev/null
+++ b/crates/units-worker/src/unit_catalog_metadata.rs
@@ -0,0 +1,198 @@
+//! Deterministic metadata for validating a governed model without invoking a
+//! conversion or a table producer. Definitions come only from the unit engine.
+
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use std::sync::OnceLock;
+
+const MAX_CATALOG_BYTES: usize = 256 * 1024;
+const MAX_CATALOG_UNITS: usize = 4096;
+
+// Struct field order is the serialized contract; rows use UTF-8 byte ordering.
+#[derive(Serialize)]
+struct Catalog {
+    version: u32,
+    implementation_version: &'static str,
+    units: Vec<Unit>,
+}
+
+#[derive(Serialize)]
+struct Unit {
+    unit: &'static str,
+    dimension: &'static str,
+    base_unit: &'static str,
+    quantity_space: &'static str,
+    factor: f64,
+    offset: f64,
+}
+
+fn serialize_catalog() -> String {
+    let mut definitions = crate::units::supported_units();
+    definitions.sort_by(|a, b| a.unit.as_bytes().cmp(b.unit.as_bytes()));
+    assert!(definitions.len() <= MAX_CATALOG_UNITS);
+    assert!(definitions
+        .windows(2)
+        .all(|rows| rows[0].unit != rows[1].unit));
+    let units = definitions
+        .into_iter()
+        .map(|row| {
+            let definition = crate::units::lookup(row.unit).expect("catalog unit must resolve");
+            assert!(definition.factor.is_finite() && definition.factor > 0.0);
+            assert!(definition.offset.is_finite());
+            Unit {
+                unit: row.unit,
+                dimension: row.dimension,
+                base_unit: row.base_unit,
+                quantity_space: quantity_space(definition.dimension),
+                factor: definition.factor,
+                offset: definition.offset,
+            }
+        })
+        .collect();
+    let serialized = serde_json::to_string(&Catalog {
+        version: 1,
+        implementation_version: crate::version(),
+        units,
+    })
+    .expect("finite static unit definitions must serialize");
+    assert!(serialized.len() <= MAX_CATALOG_BYTES);
+    serialized
+}
+
+/// The quantity space of a dimension: `affine` for temperature (offsets apply
+/// to absolute values and cancel for differences), `linear` otherwise. It
+/// belongs to the dimension, not the offset: Kelvin and Rankine are affine even
+/// with a zero offset.
+pub fn quantity_space(dimension: crate::units::Dimension) -> &'static str {
+    if dimension == crate::units::Dimension::Temperature {
+        "affine"
+    } else {
+        "linear"
+    }
+}
+
+/// Lower-case hex SHA-256 of the exact [`unit_catalog_json`] bytes, published
+/// as the strict scalars' `units.catalog_v1_sha256` tag. The full JSON is too
+/// large for a tag (agent tools bound each value to 4,000 characters), so a
+/// governed host verifies an exported copy against this digest instead.
+pub fn unit_catalog_sha256() -> &'static str {
+    static DIGEST: OnceLock<String> = OnceLock::new();
+    DIGEST.get_or_init(|| {
+        Sha256::digest(unit_catalog_json().as_bytes())
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect()
+    })
+}
+
+/// Complete `units.catalog_v1` JSON document, with exact case-preserving
+/// aliases and versioned binary64 factors. At most 4096 rows and 256 KiB UTF-8.
+/// The JSON is compact, byte deterministic, and has no trailing newline.
+pub fn unit_catalog_json() -> &'static str {
+    static CATALOG: OnceLock<String> = OnceLock::new();
+    CATALOG.get_or_init(serialize_catalog).as_str()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::Value;
+
+    #[test]
+    fn catalog_is_deterministic_bounded_sorted_and_complete() {
+        let text = unit_catalog_json();
+        assert_eq!(text, serialize_catalog());
+        assert_eq!(text, serialize_catalog());
+        assert!(text.len() <= MAX_CATALOG_BYTES);
+        assert!(!text.ends_with('\n'));
+        assert!(text.starts_with(&format!(
+            "{{\"version\":1,\"implementation_version\":\"{}\",\"units\":[",
+            crate::version()
+        )));
+        let catalog: Value = serde_json::from_str(text).unwrap();
+        assert_eq!(catalog.as_object().unwrap().len(), 3);
+        assert_eq!(catalog["version"], 1);
+        assert_eq!(catalog["implementation_version"], crate::version());
+        let rows = catalog["units"].as_array().unwrap();
+        assert_eq!(rows.len(), crate::units::unit_count());
+        assert!(rows
+            .windows(2)
+            .all(|r| r[0]["unit"].as_str().unwrap().as_bytes()
+                < r[1]["unit"].as_str().unwrap().as_bytes()));
+        for row in rows {
+            assert_eq!(row.as_object().unwrap().len(), 6);
+            let definition = crate::units::lookup(row["unit"].as_str().unwrap()).unwrap();
+            assert_eq!(row["dimension"], definition.dimension.name());
+            assert_eq!(row["base_unit"], definition.dimension.base_unit());
+            assert_eq!(
+                row["factor"].as_f64().unwrap().to_bits(),
+                definition.factor.to_bits()
+            );
+            assert_eq!(
+                row["offset"].as_f64().unwrap().to_bits(),
+                definition.offset.to_bits()
+            );
+            assert_eq!(
+                row["quantity_space"],
+                if definition.dimension == crate::units::Dimension::Temperature {
+                    "affine"
+                } else {
+                    "linear"
+                }
+            );
+        }
+    }
+
+    #[test]
+    fn digest_is_hex_sha256_of_exact_json() {
+        let digest = unit_catalog_sha256();
+        assert_eq!(digest.len(), 64);
+        assert!(digest
+            .chars()
+            .all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()));
+        let again: String = Sha256::digest(unit_catalog_json().as_bytes())
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        assert_eq!(digest, again);
+    }
+
+    #[test]
+    fn catalog_preserves_case_significant_aliases_and_affine_zero_offsets() {
+        let catalog: Value = serde_json::from_str(unit_catalog_json()).unwrap();
+        let rows = catalog["units"].as_array().unwrap();
+        let find = |unit| rows.iter().find(|r| r["unit"] == unit).unwrap();
+        assert_eq!(find("B")["factor"], 1.0);
+        assert_eq!(find("b")["factor"], 0.125);
+        assert_eq!(find("MB")["factor"], 1_000_000.0);
+        assert_eq!(find("Mb")["factor"], 125_000.0);
+        for unit in ["K", "kelvin", "R", "rankine"] {
+            assert_eq!(find(unit)["quantity_space"], "affine");
+            assert_eq!(find(unit)["offset"], 0.0);
+        }
+        assert!(rows.iter().all(|r| r["unit"] != "KM"));
+        assert!(crate::units::lookup("KM").is_some());
+    }
+
+    #[test]
+    fn catalog_bases_are_self_consistent_and_linear_offsets_are_zero() {
+        let catalog: Value = serde_json::from_str(unit_catalog_json()).unwrap();
+        let rows: std::collections::HashMap<_, _> = catalog["units"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|row| (row["unit"].as_str().unwrap(), row))
+            .collect();
+        for row in rows.values() {
+            let base = rows[row["base_unit"].as_str().unwrap()];
+            assert_eq!(base["unit"], base["base_unit"]);
+            assert_eq!(base["dimension"], row["dimension"]);
+            assert_eq!(base["quantity_space"], row["quantity_space"]);
+            assert_eq!(base["factor"], 1.0);
+            assert_eq!(base["offset"], 0.0);
+            if row["quantity_space"] == "linear" {
+                assert_eq!(row["offset"], 0.0);
+            }
+        }
+    }
